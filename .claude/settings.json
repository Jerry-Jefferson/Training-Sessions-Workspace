{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/toolchain/hooks/runtime-hook.mjs\" claude SessionStart --registration frontend-accelerator.changed-file-lint-gate.v1",
            "timeout": 15,
            "statusMessage": "Activating frontend accelerator guardrails"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/toolchain/hooks/runtime-hook.mjs\" claude PreToolUse --registration frontend-accelerator.changed-file-lint-gate.v1",
            "timeout": 15,
            "statusMessage": "Recording pre-change state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/toolchain/hooks/runtime-hook.mjs\" claude PostToolUse --registration frontend-accelerator.changed-file-lint-gate.v1",
            "timeout": 15,
            "statusMessage": "Recording changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/toolchain/hooks/runtime-hook.mjs\" claude Stop --registration frontend-accelerator.changed-file-lint-gate.v1",
            "timeout": 300,
            "statusMessage": "Linting files changed in this session"
          }
        ]
      }
    ]
  }
}
